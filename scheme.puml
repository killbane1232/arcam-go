@startuml GoArc Application Architecture

!define DOMAIN_COLOR #E1F5FF
!define PORT_COLOR #FFF4E1
!define ADAPTER_COLOR #E8F5E9
!define SERVICE_COLOR #F3E5F5
!define CMD_COLOR #FFE0E0
!define PKG_COLOR #E0E0E0

package "Domain Layer" DOMAIN_COLOR {
  package "Entities" {
    class Candle {
      +Timestamp: time.Time
      +Open: float64
      +High: float64
      +Low: float64
      +Close: float64
      +Volume: float64
    }
    
    class CandleSequence {
      +Input: []Candle
      +Output: []Candle
    }
    
    class TrainingData {
      +Sequences: []CandleSequence
      +Symbol: string
      +BinSize: string
    }
    
    class Order {
      +ID: string
      +Symbol: string
      +Side: OrderSide
      +Type: OrderType
      +Price: Price
      +Quantity: Quantity
      +Status: OrderStatus
      +CreatedAt: time.Time
      +UpdatedAt: time.Time
      +ExchangeOrderID: string
      +FilledQuantity: Quantity
      +IsActive(): bool
      +Fill(quantity: Quantity): error
      +Cancel(): error
      +RemainingQuantity(): Quantity
    }
    
    enum OrderType {
      Market
      Limit
    }
    
    enum OrderSide {
      Buy
      Sell
    }
    
    enum OrderStatus {
      New
      PartiallyFilled
      Filled
      Cancelled
      Rejected
    }
    
    class Position {
      +Symbol: string
      +Size: Quantity
      +AvgEntryPrice: Price
      +Leverage: int
      +CreatedAt: time.Time
      +UpdatedAt: time.Time
      +CurrentPrice: Price
      +IsLong(): bool
      +IsShort(): bool
      +IsFlat(): bool
      +UpdatePrice(price: Price)
      +CalculateUnrealizedPnL(): Money
      +CalculateLiquidationPrice(): Price
    }
    
    class Trade {
      +ID: string
      +OrderID: string
      +Symbol: string
      +Side: OrderSide
      +Price: Price
      +Quantity: Quantity
      +Fee: Money
      +Timestamp: time.Time
      +TotalCost(): Money
    }
  }
  
  package "Value Objects" {
    class Price {
      -value: decimal.Decimal
      -currency: string
      +Value(): decimal.Decimal
      +Currency(): string
      +Multiply(qty: Quantity): Money
      +Compare(other: Price): int
      +GreaterThan(other: Price): bool
      +LessThan(other: Price): bool
      +Equal(other: Price): bool
      +Add(other: Price): Price
      +Subtract(other: Price): Price
      +Percentage(of: Price): Percentage
      +RoundToTick(tickSize: decimal): Price
    }
    
    class Quantity {
      -value: decimal.Decimal
      +Value(): decimal.Decimal
      +Compare(other: Quantity): int
      +GreaterThan(other: Quantity): bool
      +LessThan(other: Quantity): bool
      +Equal(other: Quantity): bool
      +Validate(lotSize, min, max: decimal): error
    }
    
    class Money {
      -amount: decimal.Decimal
      -currency: string
      +Amount(): decimal.Decimal
      +Currency(): string
      +IsPositive(): bool
      +IsZero(): bool
      +Add(other: Money): Money
      +Subtract(other: Money): Money
      +Multiply(factor: decimal): Money
      +Divide(factor: decimal): Money
      +Percentage(p: Percentage): Money
    }
    
    class Percentage {
      -value: decimal.Decimal
      +Value(): decimal.Decimal
      +DecimalFraction(): decimal.Decimal
      +String(): string
    }
    
    class PriceDelta {
      -value: decimal.Decimal
      +Value(): decimal.Decimal
      +IsPositive(): bool
      +IsNegative(): bool
    }
  }
}

package "Ports" PORT_COLOR {
  interface ExchangeClient {
    +Connect(ctx: context): error
    +Close(ctx: context): error
    +PlaceLimitOrder(symbol, side, price, qty): Order
    +PlaceMarketOrder(symbol, side, qty): Order
    +CancelOrder(symbol, orderID): error
    +GetOrder(symbol, orderID): Order
    +GetPosition(symbol): Position
    +GetLastPrice(symbol): Price
  }
}

package "Adapters" ADAPTER_COLOR {
  package "Exchange" {
    class BitMEXClient {
      -httpClient: *http.Client
      -apiKey: string
      -apiSecret: string
      -baseURL: string
      -limiter: *TokenBucket
      +PlaceLimitOrder(...): Order
      +PlaceMarketOrder(...): Order
      +CancelOrder(...): error
      +GetOrder(...): Order
      +GetPosition(...): Position
      +GetLastPrice(...): Price
      -doRequest(...): []byte
      -signRequest(...): string
    }
    
    class TokenBucket {
      +Take(): error
    }
    
    class OrderParser {
      +ParseOrder(data: []byte): Order
    }
    
    class RateLimiter {
      +Take(): error
    }
    
    class Retry {
      +Retry(fn: func): error
    }
    
    class WebSocket {
      +Connect(): error
      +Subscribe(...): error
      +ReadMessage(): Message
    }
  }
  
  package "Ollama" {
    class OllamaClient {
      -baseURL: string
      +Train(data: TrainingData): error
      +Predict(input: []Candle): []Candle
    }
  }
}

package "Services" SERVICE_COLOR {
  package "Trading" {
    class BitMEXEngine {
      -status: EngineStatus
      -config: TradingConfig
      -exchangeClient: ExchangeClient
      -riskManager: RiskManager
      -auditor: Auditor
      -signalBuilder: SignalBuilder
      -currentPosition: *Position
      -activeOrders: map[string]*Order
      +Start(ctx): error
      +Stop(): error
      +Pause(): error
      +Resume(): error
      +Status(): EngineStatus
      +ProcessSignal(signal: TradingSignal): error
      +ProcessManualOrder(side, qty): error
      +UpdateConfig(config): error
      +GetConfig(): TradingConfig
      -signalProcessor(ctx)
      -orderProcessor(ctx)
      -positionMonitor(ctx)
      -controlProcessor(ctx)
    }
    
    enum EngineStatus {
      Stopped
      Running
      Paused
    }
    
    class TradingConfig {
      +Symbol: string
      +MaxCapitalUsage: Percentage
      +PositionSizePercent: Percentage
      +StopLossPercent: Percentage
      +TakeProfitPercent: Percentage
    }
    
    interface RiskManager {
      +ValidateSignal(signal, position): error
      +CalculatePositionSize(price, sizePercent): Quantity
      +ValidateConfig(config): error
      +GetRiskMetrics(): RiskMetrics
    }
    
    class BitMEXRiskManager {
      -exchangeClient: ExchangeClient
      -maxCapitalUsage: Percentage
      +ValidateSignal(...): error
      +CalculatePositionSize(...): Quantity
      +ValidateConfig(...): error
      +GetRiskMetrics(): RiskMetrics
    }
    
    class RiskMetrics {
      +CurrentCapitalUsage: Percentage
      +MaxCapitalUsage: Percentage
      +OpenPositionsCount: int
      +DailyPnL: Money
    }
    
    interface Auditor {
      +LogEvent(ctx, eventType, message, data): error
      +GetEvents(ctx, filter): []AuditEvent
    }
    
    class BitMEXAuditor {
      -storage: AuditStorage
      +LogEvent(...): error
      +GetEvents(...): []AuditEvent
    }
    
    class AuditEvent {
      +ID: string
      +Timestamp: time.Time
      +Type: string
      +Message: string
      +Data: interface{}
      +UserID: string
    }
    
    interface AuditStorage {
      +SaveEvent(ctx, event): error
      +GetEvents(ctx, filter): []AuditEvent
    }
  }
  
  package "Indicator" {
    class OHLCV {
      +Timestamp: time.Time
      +Open: decimal.Decimal
      +High: decimal.Decimal
      +Low: decimal.Decimal
      +Close: decimal.Decimal
      +Volume: decimal.Decimal
    }
    
    interface Calculator {
      +Calculate(ctx, data: []OHLCV): IndicatorValue
      +Type(): IndicatorType
      +Period(): int
      +Name(): string
      +ValidateConfig(): error
    }
    
    class EMA {
      -period: int
      -name: string
      +Calculate(ctx, data: []OHLCV): IndicatorValue
      +Type(): IndicatorType
      +Period(): int
      +Name(): string
    }
    
    class Aroon {
      -period: int
      -name: string
      +Calculate(ctx, data: []OHLCV): IndicatorValue
      +Type(): IndicatorType
      +Period(): int
      +Name(): string
    }
    
    class IndicatorValue {
      +Timestamp: time.Time
      +Value: decimal.Decimal
      +Values: map[string]decimal.Decimal
    }
    
    enum IndicatorType {
      EMA
      Aroon
    }
    
    class IndicatorConfig {
      +Type: IndicatorType
      +Period: int
      +Name: string
    }
    
    interface CalculatorFactory {
      +CreateCalculator(config): Calculator
    }
    
    class DefaultFactory {
      +CreateCalculator(config): Calculator
    }
    
    class Registry {
      -calculators: map[string]Calculator
      -factory: CalculatorFactory
      +Register(config): error
      +Get(name): Calculator
      +CalculateAll(ctx, data): map[string]IndicatorValue
    }
    
    class SignalBuilder {
      -rules: []SignalRule
      -registry: *Registry
      +AddRule(rule): error
      +LoadRulesFromJSON(data): error
      +Evaluate(ctx, symbol, data): []TradingSignal
      -evaluateRule(rule, values): bool
    }
    
    class TradingSignal {
      +Type: SignalType
      +Strength: SignalStrength
      +Symbol: string
      +Timestamp: int64
      +Reason: string
      +Indicators: map[string]decimal.Decimal
    }
    
    enum SignalType {
      Buy
      Sell
      Hold
    }
    
    enum SignalStrength {
      Weak
      Medium
      Strong
    }
    
    class SignalRule {
      +Name: string
      +Conditions: []RuleCondition
      +SignalType: SignalType
      +Strength: SignalStrength
      +Description: string
    }
    
    class RuleCondition {
      +Indicator: string
      +Field: string
      +Operator: string
      +Value: decimal.Decimal
    }
  }
  
  package "Market Data" {
    interface Stream {
      +Connect(ctx): error
      +Close(ctx): error
      +SubscribeTrades(symbol): error
      +SubscribeOrderBookL2(symbol): error
      +Events(): <-chan StreamEvent
      +Errors(): <-chan error
    }
    
    class BitmexStream {
      -events: chan StreamEvent
      -errs: chan error
      -wsURL: string
      -binSize: string
      -conn: *websocket.Conn
      +Connect(ctx): error
      +Close(ctx): error
      +SubscribeTrades(symbol): error
      +Events(): <-chan StreamEvent
      +Errors(): <-chan error
      -readLoop(ctx)
      -manageConnection(ctx)
      -subscribeCandles(symbol, binSize): error
    }
    
    class StreamEvent {
      +Channel: string
      +Symbol: string
      +Raw: interface{}
    }
    
    class Candle {
      +Timestamp: int64
      +Open: float64
      +High: float64
      +Low: float64
      +Close: float64
      +Volume: float64
    }
    
    class CandleHandler {
      -stream: Stream
      -registry: *Registry
      -symbol: string
      -bot: *TeleBot
      +Start(ctx): error
      -handleCandle(candle: Candle)
    }
  }
  
  package "TeleBot" {
    class TeleBot {
      -bot: *tgbotapi.BotAPI
      -config: BotConfig
      -tradingEngine: Engine
      -signalBuilder: *SignalBuilder
      -userStates: *UserStateManager
      +Start(ctx): error
      +SendText(text): error
      -handleUpdate(update)
      -handleCommand(message)
      -handleMessage(message)
      -handleCallback(callback)
    }
    
    class BotConfig {
      +Token: string
      +AdminUserIDs: []int64
      +WebhookURL: string
      +WebhookPort: string
      +ChatID: int64
    }
    
    class UserStateManager {
      -states: map[int64]*UserState
      +GetState(userID): UserState
      +SetState(userID, state)
      +UpdateLastActive(userID)
    }
    
    class UserState {
      +CurrentState: StateType
      +Data: map[string]interface{}
      +LastActive: int64
    }
    
    enum StateType {
      MainMenu
      SettingEMA
      SettingAroon
      SettingRule
      SettingRisk
    }
  }
  
  package "Training" {
    class Trainer {
      -config: *TrainingConfig
      +Train(): error
      -prepareData(): TrainingData
      -trainModel(data: TrainingData): error
    }
    
    class CandleParser {
      +ParseCSV(path: string): []Candle
      +CreateSequences(candles, inputSize, outputSize): []CandleSequence
    }
  }
}

package "Commands" CMD_COLOR {
  class ApexTraderMain {
    +main()
    -dumpLastCandlesWS(ctx, cfg): error
  }
  
  class TelebotMain {
    +main()
  }
  
  class TrainMain {
    +main()
  }
}

package "Config" PKG_COLOR {
  class Config {
    +App: AppConfig
    +Bitmex: BitmexConfig
    +Trading: TradingConfig
    +Telebot: TelebotConfig
    +Candles: CandlesDump
    +Training: TrainingConfig
    +Load(path: string): *Config
  }
  
  class AppConfig {
    +Env: string
    +LogLevel: string
  }
  
  class BitmexConfig {
    +BaseURL: string
    +WSURL: string
    +TimeoutMs: int
  }
  
  class TradingConfig {
    +Symbol: string
    +Leverage: int
  }
  
  class TelebotConfig {
    +Token: string
    +ChatID: int64
  }
  
  class CandlesDump {
    +Enabled: bool
    +Symbol: string
    +BinSize: string
    +Count: int
    +Output: string
    +Reverse: bool
  }
  
  class TrainingConfig {
    +Enabled: bool
    +Model: string
    +OllamaURL: string
    +InputCandles: int
    +OutputCandles: int
    +Symbol: string
    +BinSize: string
    +TrainingDataPath: string
    +Epochs: int
    +LearningRate: float64
  }
}

' Relationships

' Domain relationships
Order *-- Price
Order *-- Quantity
Order --> OrderSide
Order --> OrderType
Order --> OrderStatus
Position *-- Price
Position *-- Quantity
Trade *-- Price
Trade *-- Quantity
Trade *-- Money
Trade --> OrderSide

' Value objects relationships
Price ..> Money : creates
Price ..> Percentage : creates
Money *-- Percentage

' Ports to Adapters
ExchangeClient <|.. BitMEXClient
BitMEXClient --> TokenBucket
BitMEXClient --> OrderParser

' Services to Domain
BitMEXEngine --> Order
BitMEXEngine --> Position
BitMEXEngine --> TradingSignal
BitMEXEngine --> TradingConfig
BitMEXEngine ..> ExchangeClient : uses
BitMEXEngine ..> RiskManager : uses
BitMEXEngine ..> Auditor : uses
BitMEXEngine ..> SignalBuilder : uses

RiskManager <|.. BitMEXRiskManager
BitMEXRiskManager --> RiskMetrics
BitMEXRiskManager ..> ExchangeClient : uses
BitMEXRiskManager --> Percentage
BitMEXRiskManager --> Money

Auditor <|.. BitMEXAuditor
BitMEXAuditor --> AuditEvent
BitMEXAuditor ..> AuditStorage : uses

' Indicator relationships
Calculator <|.. EMA
Calculator <|.. Aroon
Registry --> Calculator
Registry ..> CalculatorFactory : uses
CalculatorFactory <|.. DefaultFactory
SignalBuilder --> Registry
SignalBuilder --> TradingSignal
SignalBuilder --> SignalRule
SignalRule --> RuleCondition
TradingSignal --> SignalType
TradingSignal --> SignalStrength
EMA --> IndicatorValue
Aroon --> IndicatorValue
Calculator ..> OHLCV : uses

' Market Data relationships
Stream <|.. BitmexStream
BitmexStream --> StreamEvent
CandleHandler ..> Stream : uses
CandleHandler --> Registry
CandleHandler --> Candle
StreamEvent --> Candle

' TeleBot relationships
TeleBot --> BotConfig
TeleBot --> UserStateManager
TeleBot ..> Engine : uses
TeleBot ..> SignalBuilder : uses
UserStateManager --> UserState
UserState --> StateType

' Training relationships
Trainer --> TrainingConfig
Trainer --> CandleParser
CandleParser --> Candle
CandleParser --> CandleSequence
Trainer --> TrainingData
TrainingData --> CandleSequence
CandleSequence --> Candle

' Commands relationships
ApexTraderMain --> Config
ApexTraderMain ..> Stream : uses
ApexTraderMain ..> Registry : uses
ApexTraderMain ..> TeleBot : uses
ApexTraderMain ..> CandleHandler : uses

TelebotMain --> Config
TelebotMain ..> TeleBot : uses

TrainMain --> Config
TrainMain ..> Trainer : uses

' Config relationships
Config --> AppConfig
Config --> BitmexConfig
Config --> TradingConfig
Config --> TelebotConfig
Config --> CandlesDump
Config --> TrainingConfig

' Notes
note right of ExchangeClient
  Интерфейс для работы
  с биржей (порт)
end note

note right of BitMEXEngine
  Основной торговый движок
  обрабатывает сигналы и
  управляет ордерами
end note

note right of SignalBuilder
  Генерирует торговые сигналы
  на основе правил и индикаторов
end note

note right of BitmexStream
  WebSocket поток данных
  от BitMEX
end note

@enduml
