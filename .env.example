# Required for Docker. Generate a token with: openssl rand -hex 32
ARCAM_API_TOKEN=

# Published image; a release tag or sha-<commit> can be used instead of latest.
ARCAM_IMAGE=ghcr.io/killbane1232/arcam-go:latest

# Host address and port. For LAN access, use 0.0.0.0 and set ARCAM_ALLOWED_HOSTS.
ARCAM_BIND_ADDRESS=127.0.0.1
ARCAM_PORT=8080

# Ollama running on the Docker host. LLM connections can also be set in the UI.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# IP addresses, domains or CIDR networks (IPv4/IPv6) for the browser URL's host.
# Do not include a URL scheme, port or path. CIDRs match server IPs, not client IPs.
# Required for LAN/remote access, including direct access by IP.
# Separate entries with commas. Localhost is always allowed.
# Example: ARCAM_ALLOWED_HOSTS=192.168.31.0/24,arcam.example.com,fd00:31::/64
ARCAM_ALLOWED_HOSTS=
