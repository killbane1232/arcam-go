{
  "name": "EMA + LLM confirmation",
  "description": "EMA/Aroon entry filtered by model support >= 0.75.",
  "indicators": [
    {
      "id": "fast",
      "type": "ema",
      "period": 12
    },
    {
      "id": "slow",
      "type": "ema",
      "period": 26
    },
    {
      "id": "trend",
      "type": "aroon",
      "period": 25
    }
  ],
  "rules": {
    "enter_long": {
      "all": [
        {
          "left": {
            "field": "fast.value"
          },
          "op": "gt",
          "right": {
            "field": "slow.value"
          }
        },
        {
          "left": {
            "field": "trend.up"
          },
          "op": "gt",
          "right": {
            "value": 70
          }
        },
        {
          "left": {
            "field": "llm.enter_long"
          },
          "op": "gte",
          "right": {
            "value": 0.75
          }
        }
      ]
    },
    "exit_long": {
      "left": {
        "field": "fast.value"
      },
      "op": "lt",
      "right": {
        "field": "slow.value"
      }
    },
    "enter_short": {
      "all": [
        {
          "left": {
            "field": "fast.value"
          },
          "op": "lt",
          "right": {
            "field": "slow.value"
          }
        },
        {
          "left": {
            "field": "trend.down"
          },
          "op": "gt",
          "right": {
            "value": 70
          }
        },
        {
          "left": {
            "field": "llm.enter_short"
          },
          "op": "gte",
          "right": {
            "value": 0.75
          }
        }
      ]
    },
    "exit_short": {
      "left": {
        "field": "fast.value"
      },
      "op": "gt",
      "right": {
        "field": "slow.value"
      }
    }
  },
  "risk": {
    "position_fraction": 0.5,
    "stop_loss": 0.03,
    "take_profit": 0.06
  },
  "llm": {
    "provider": "ollama",
    "model": "your-model",
    "lookback": 30,
    "instructions": "Evaluate trend continuation and reversal risk from the supplied indicators and closed candles."
  }
}
